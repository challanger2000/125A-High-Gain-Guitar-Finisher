<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <colors>
    <color name="Background" rgba="#0E1014FF"/>
    <color name="Text" rgba="#F1F3F6FF"/>
    <color name="Muted" rgba="#9EA5B1FF"/>
    <color name="Minor" rgba="#747D8BFF"/>
    <color name="Value" rgba="#C8CDD6FF"/>
    <color name="Accent" rgba="#7668FFFF"/>
    <color name="SwitchFrame" rgba="#3A3F4AFF"/>
  </colors>
  <fonts>
    <font name="Title" font-name="Arial" size="25" bold="true" italic="false"/>
    <font name="Subtitle" font-name="Arial" size="11" bold="false" italic="false"/>
    <font name="Section" font-name="Arial" size="12" bold="true" italic="false"/>
    <font name="Label" font-name="Arial" size="12" bold="true" italic="false"/>
    <font name="ValueFont" font-name="Arial" size="12" bold="false" italic="false"/>
    <font name="Small" font-name="Arial" size="10" bold="false" italic="false"/>
    <font name="SwitchFont" font-name="Arial" size="10" bold="true" italic="false"/>
  </fonts>
  <gradients>
    <gradient name="SwitchNormal">
      <color-stop rgba="#252A32FF" start="0"/>
      <color-stop rgba="#0B0E13FF" start="1"/>
    </gradient>
    <gradient name="SwitchSelected">
      <color-stop rgba="#8A7CFFFF" start="0"/>
      <color-stop rgba="#4E43B8FF" start="1"/>
    </gradient>
  </gradients>

  <template name="view" class="CViewContainer" origin="0,0" size="1120,620" transparent="false" background-color="Background">
    <view class="CView" custom-view-name="HGGFPanel" origin="0,0" size="1120,620" mouse-enabled="false"/>

    <view class="CView" custom-view-name="HGGFBrandLogo" origin="55,29" size="120,60" mouse-enabled="false"/>
    <view class="CTextLabel" origin="250,29" size="620,38" title="H I G H   G A I N   G U I T A R   F I N I S H E R" transparent="true" font-color="Text" font="Title" text-alignment="center" mouse-enabled="false"/>
    <view class="CTextLabel" origin="360,66" size="400,18" title="POST-AMP / POST-CAB FINISHING PROCESSOR" transparent="true" font-color="Muted" font="Subtitle" text-alignment="center" mouse-enabled="false"/>

    <view class="CSegmentButton" origin="906,34" size="118,28" control-tag="9000" style="horizontal" segment-names="100%,150%" font="SwitchFont" text-color="Muted" text-color-highlighted="Text" gradient="SwitchNormal" gradient-highlighted="SwitchSelected" frame-color="SwitchFrame" frame-width="1" round-radius="14"/>
    <view class="CSegmentButton" origin="906,68" size="118,28" control-tag="103" style="horizontal" segment-names="ACTIVE,BYPASS" font="SwitchFont" text-color="Muted" text-color-highlighted="Text" gradient="SwitchNormal" gradient-highlighted="SwitchSelected" frame-color="SwitchFrame" frame-width="1" round-radius="14"/>

    <view class="CTextLabel" origin="54,128" size="180,18" title="FINISH CHARACTER" transparent="true" font-color="Muted" font="Section" text-alignment="left" mouse-enabled="false"/>
    <view class="CSegmentButton" origin="54,154" size="580,42" control-tag="106" style="horizontal" segment-names="1 OPEN,2 BITE,3 SMOOTH" font="SwitchFont" text-color="Muted" text-color-highlighted="Text" gradient="SwitchNormal" gradient-highlighted="SwitchSelected" frame-color="SwitchFrame" frame-width="1" round-radius="9"/>

    <view class="CTextLabel" origin="670,128" size="390,18" title="SIGNAL PATH" transparent="true" font-color="Muted" font="Section" text-alignment="left" mouse-enabled="false"/>
    <view class="CTextLabel" origin="670,157" size="390,18" title="TONE → FINISH → MASS → ROOM → OUTPUT" transparent="true" font-color="Text" font="Small" text-alignment="left" mouse-enabled="false"/>
    <view class="CTextLabel" origin="670,181" size="390,16" title="ZERO LOOKAHEAD · AUTO LEVEL · TRUE 0–100% WET" transparent="true" font-color="Minor" font="Small" text-alignment="left" mouse-enabled="false"/>

    <view class="CTextLabel" origin="72,315" size="194,18" title="TONE CONTROL" transparent="true" font-color="Muted" font="Section" text-alignment="center" mouse-enabled="false"/>
    <view class="CView" custom-view-name="HGGFKnobLowCut" origin="66,348" size="104,104"/>
    <view class="CView" custom-view-name="HGGFKnobMass" origin="170,348" size="104,104"/>
    <view class="CTextLabel" origin="64,463" size="108,18" title="LOW CUT" transparent="true" font-color="Text" font="Label" text-alignment="center" mouse-enabled="false"/>
    <view class="CTextLabel" origin="168,463" size="108,18" title="MASS" transparent="true" font-color="Text" font="Label" text-alignment="center" mouse-enabled="false"/>
    <view class="CTextEdit" origin="74,487" size="88,22" control-tag="104" transparent="true" frame-width="0" font-color="Value" font="ValueFont" text-alignment="center"/>
    <view class="CTextEdit" origin="178,487" size="88,22" control-tag="107" transparent="true" frame-width="0" font-color="Value" font="ValueFont" text-alignment="center"/>

    <view class="CTextLabel" origin="354,312" size="200,18" title="MAIN PROCESSING" transparent="true" font-color="Muted" font="Section" text-alignment="center" mouse-enabled="false"/>
    <view class="CView" custom-view-name="HGGFKnobFinish" origin="374,332" size="160,160"/>
    <view class="CTextLabel" origin="379,493" size="150,20" title="FINISH" transparent="true" font-color="Text" font="Label" text-alignment="center" mouse-enabled="false"/>
    <view class="CTextEdit" origin="414,514" size="80,20" control-tag="100" transparent="true" frame-width="0" font-color="Value" font="ValueFont" text-alignment="center"/>

    <view class="CTextLabel" origin="659,312" size="200,18" title="INDUSTRIAL ROOM" transparent="true" font-color="Muted" font="Section" text-alignment="center" mouse-enabled="false"/>
    <view class="CTextLabel" origin="659,333" size="200,15" title="TRUE DRY / WET · METALLIC TAIL" transparent="true" font-color="Minor" font="Small" text-alignment="center" mouse-enabled="false"/>
    <view class="CView" custom-view-name="HGGFKnobWet" origin="654,365" size="96,96"/>
    <view class="CView" custom-view-name="HGGFKnobDecay" origin="768,365" size="96,96"/>
    <view class="CTextLabel" origin="654,466" size="96,18" title="WET" transparent="true" font-color="Text" font="Label" text-alignment="center" mouse-enabled="false"/>
    <view class="CTextLabel" origin="768,466" size="96,18" title="DECAY" transparent="true" font-color="Text" font="Label" text-alignment="center" mouse-enabled="false"/>
    <view class="CTextEdit" origin="662,489" size="80,20" control-tag="101" transparent="true" frame-width="0" font-color="Value" font="ValueFont" text-alignment="center"/>
    <view class="CTextEdit" origin="776,489" size="80,20" control-tag="105" transparent="true" frame-width="0" font-color="Value" font="ValueFont" text-alignment="center"/>

    <view class="CTextLabel" origin="929,312" size="122,18" title="OUTPUT" transparent="true" font-color="Muted" font="Section" text-alignment="center" mouse-enabled="false"/>
    <view class="CView" custom-view-name="HGGFKnobOutput" origin="941,361" size="98,98"/>
    <view class="CTextLabel" origin="929,468" size="122,18" title="LEVEL" transparent="true" font-color="Text" font="Label" text-alignment="center" mouse-enabled="false"/>
    <view class="CTextEdit" origin="949,490" size="82,22" control-tag="102" transparent="true" frame-width="0" font-color="Value" font="ValueFont" text-alignment="center"/>

    <view class="CTextLabel" origin="54,565" size="470,18" title="125A AUDIO SOFTWARE · MEASUREMENT-DRIVEN DSP" transparent="true" font-color="Minor" font="Small" text-alignment="left" mouse-enabled="false"/>
    <view class="CTextLabel" origin="596,565" size="470,18" title="POST-AMP / POST-CAB · ZERO LOOKAHEAD LATENCY" transparent="true" font-color="Minor" font="Small" text-alignment="right" mouse-enabled="false"/>
  </template>
</vstgui-ui-description>
